# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=anonymous:anonymous-kauri

VITE_CONVEX_URL=http://127.0.0.1:3210

VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

VITE_CLERK_PUBLISHABLE_KEY=

VITE_SENTRY_DSN=

RESEND_API_KEY=

RESEND_FROM_EMAIL=noreply@votre-domaine.com
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Twilio — envoi des identifiants agent par WhatsApp (repli SMS automatique).
# Ces variables sont lues par convex/notifications.ts (une action serveur) :
# elles doivent être définies sur le déploiement Convex via
# `npx convex env set NOM valeur`, pas seulement dans ce fichier.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Sandbox WhatsApp tant que le sender Business n'est pas approuvé par Meta
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Numéro Twilio distinct capable d'envoyer de vrais SMS (le numéro sandbox WhatsApp ne le peut pas)
TWILIO_SMS_FROM=
